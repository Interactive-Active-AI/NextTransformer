---
import invite from '../../../website/public/community/wechat-invite.json';
interface Props { chinese?: boolean }
const { chinese = false } = Astro.props;
const images = import.meta.glob<string>('../../../website/public/community/wechat-qr.png', {
  eager: true, import: 'default', query: '?url',
});
const qr = Object.values(images)[0];
const cutoff = invite.expiresBefore;
const dateLabel = cutoff && new Intl.DateTimeFormat(chinese ? 'zh-CN' : 'en-US', {
  timeZone: 'Asia/Shanghai', dateStyle: 'long',
}).format(new Date(cutoff));
const expired = Boolean(cutoff && Date.now() >= Date.parse(cutoff));
---
{qr ? (
  <div data-wechat-until={cutoff}>
    <figure hidden={expired}>
      <img src={qr} width="280" height="280" alt={chinese ? 'NextTransformer 交流群入群二维码' : 'QR code for the NextTransformer WeChat group'} />
      <figcaption>
        {chinese ? '用微信扫描或长按识别二维码加入 NextTransformer 交流群。' : 'Scan with WeChat to join the NextTransformer group.'}
        {dateLabel && <time datetime={cutoff}>{chinese ? `请在北京时间 ${dateLabel}前使用。` : `Use before ${dateLabel} (China time).`}</time>}
      </figcaption>
    </figure>
    <p hidden={!expired}>{chinese ? '本期群码已过期。新码发布后，可从本页加入交流群。' : 'This invitation has expired. The next QR code will appear on this page.'}</p>
  </div>
) : (
  <p>{chinese ? '群邀请尚未开放。二维码发布后会显示在这里。' : 'The group invite is not available yet. Its QR code will appear here.'}</p>
)}

<script>
  // A static Pages deployment can outlive its group invitation.
  function updateInvite() {
    for (const box of document.querySelectorAll<HTMLElement>('[data-wechat-until]')) {
      const cutoff = box.dataset.wechatUntil;
      if (!cutoff || Date.now() < Date.parse(cutoff)) continue;
      box.querySelector('figure')?.setAttribute('hidden', '');
      box.querySelector('p')?.removeAttribute('hidden');
    }
  }
  updateInvite();
  window.addEventListener('pageshow', updateInvite);
</script>

<style>
  [hidden] { display: none; }
  img { display: block; max-width: 100%; height: auto; }
  time { display: block; }
</style>
